
/* Global widget text/background */
QWidget { color: #dddddd; background-color: #1e1e1e; }
QToolTip { color: #111; background: #e4e4e4; border: 1px solid #aaa; }

/* Buttons */
QPushButton {
  background: #2b2b2b;
  color: #dddddd;
  border: 1px solid #555;
  border-radius: 4px;
  padding: 5px 10px;
}
QPushButton:hover    { background: #333; border: 1px solid #666; }
QPushButton:pressed  { background: #252525; border: 1px solid #777; }
QPushButton:disabled { background: #262626; color: #888; border: 1px solid #444; }
QPushButton:default  { border: 1px solid #3aa86b; }

/* Tool buttons (if used) */
QToolButton {
  background: #2b2b2b;
  color: #dddddd;
  border: 1px solid #555;
  border-radius: 4px;
  padding: 4px 8px;
}
QToolButton:hover   { background: #333; border: 1px solid #666; }
QToolButton:pressed { background: #252525; border: 1px solid #777; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background: #252525;
  color: #dddddd;
  border: 1px solid #555;
  border-radius: 3px;
  padding: 2px 4px;
}
QComboBox QAbstractItemView {
  background: #252525;
  selection-background-color: #3aa86b;
  selection-color: #111;
}

/* Checkboxes */
QCheckBox {
  color: #dddddd;
  spacing: 6px;
}
QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #666;
  border-radius: 3px;
  background: #3a3a3a;
}
QCheckBox::indicator:hover {
  border: 1px solid #888;
  background: #454545;
}
QCheckBox::indicator:checked {
  background: #5c9ded;
  border: 1px solid #5c9ded;
}
QCheckBox::indicator:checked:hover {
  background: #6eadff;
  border: 1px solid #6eadff;
}

/* Sliders */
QSlider { min-height: 18px; }
QSlider::groove:horizontal {
  border: 1px solid #444;
  height: 6px;
  margin: 8px 12px;
  background: #2b2b2b;
  border-radius: 3px;
}
QSlider::sub-page:horizontal {
  background: #5c9ded;
  border: 1px solid #5c9ded;
  height: 6px;
  border-radius: 3px;
}
QSlider::add-page:horizontal {
  background: #1e1e1e;
  border: 1px solid #444;
  height: 6px;
  border-radius: 3px;
}
QSlider::handle:horizontal {
  background: #ddd;
  border: 1px solid #666;
  width: 14px;
  height: 14px;
  margin: -6px 0; /* center on 6px groove */
  border-radius: 7px;
}

/* Docks / Menus */
QDockWidget::title {
  padding-left: 6px;
  background: #202020;
  border-bottom: 1px solid #444;
}
QMenu {
  background: #222;
  color: #ddd;
  border: 1px solid #444;
}
QMenu::item {
  padding: 6px 20px;
}

QMenu::item::shortcut {
    padding-right: 24px;
}

QMenu::item:selected {
    background-color: #3a3a3a;
}

QMenu::item:selected { background: #333; }
